rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A room_name is only valid for its area: rooms are 3–4 digit numbers,
    // and public areas / restaurants must match the known list. This rejects
    // arbitrary strings written by anything bypassing the UI combobox. The
    // small lists mirror public/js/locations.js — keep them in sync if edited.
    function validRoomName(area, name) {
      return (area == 'Rooms' && name.matches('^[0-9]{3,4}$'))
        || (area == 'Public Area' && name in ['Lobby', 'Business Centre', 'Pool Area', 'Car Check', 'Driveway', 'Fountain Lounge', 'Front Office', 'Elevators'])
        || (area == 'Restaurant' && name in ['Grand Cafe', 'Poolside', 'Fountain Lounge', 'Club Italiano', 'Sumire']);
    }

    match /defects/{defectId} {
      allow read: if request.auth != null;

      // New defects must arrive in 'Reported' state with a before photo.
      allow create: if request.auth != null
        && request.resource.data.area in ['Rooms', 'Public Area', 'Restaurant']
        && request.resource.data.room_name is string
        && request.resource.data.room_name.size() > 0
        && validRoomName(request.resource.data.area, request.resource.data.room_name)
        && request.resource.data.reported_by is string
        && request.resource.data.reported_by.size() > 0
        && request.resource.data.department in ['Managerial', 'Engineering', 'F&B', 'Rooms', 'Housekeeping', 'Others']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.type in ['Civil', 'Machinery', 'Other']
        && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.status == 'Reported'
        && request.resource.data.before_picture_url is string
        && request.resource.data.before_picture_url.size() > 0;

      // Workers may only move status forward and may not touch the
      // original report fields.
      allow update: if request.auth != null
        && resource.data.status != 'Completed'
        && request.resource.data.status in ['In Progress', 'Completed']
        && request.resource.data.area == resource.data.area
        && request.resource.data.before_picture_url == resource.data.before_picture_url
        && request.resource.data.reported_by == resource.data.reported_by
        && request.resource.data.room_name == resource.data.room_name
        && request.resource.data.title == resource.data.title
        && request.resource.data.type == resource.data.type
        && request.resource.data.priority == resource.data.priority;

      allow delete: if false;
    }
  }
}
