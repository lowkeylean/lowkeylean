rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A room_name is only valid for its area: rooms are 3–4 digit numbers,
    // and public areas / restaurants must match the known list. This rejects
    // arbitrary strings written by anything bypassing the UI combobox. The
    // small lists mirror public/js/locations.js — keep them in sync if edited.
    function validRoomName(area, name) {
      return (area == 'Rooms' && name.matches('^[0-9]{3,4}$'))
        || (area == 'Public Area' && name in ['Lobby', 'Business Centre', 'Pool Area', 'Car Check', 'Driveway', 'Fountain Lounge', 'Front Office', 'Elevators', 'Olympus Male', 'Olympus Female', 'Tennis Court', 'Public Restrooms L3', 'Public Restrooms L4'])
        || (area == 'Restaurant' && name in ['Grand Cafe', 'Poolside', 'Fountain Lounge', 'Club Italiano', 'Sumire', 'Grand Club', 'Cheers', 'Pierre Herme', 'Banquet']);
    }

    match /defects/{defectId} {
      allow read: if request.auth != null;

      // New defects must arrive in 'Reported' state with a before photo.
      allow create: if request.auth != null
        && request.resource.data.area in ['Rooms', 'Public Area', 'Restaurant']
        && request.resource.data.room_name is string
        && request.resource.data.room_name.size() > 0
        && validRoomName(request.resource.data.area, request.resource.data.room_name)
        && request.resource.data.reported_by is string
        && request.resource.data.reported_by.size() > 0
        && request.resource.data.department in ['Managerial', 'Engineering', 'F&B', 'Rooms', 'Housekeeping', 'Others']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.type in ['Civil', 'Machinery', 'Other']
        && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.status == 'Reported'
        && request.resource.data.before_picture_url is string
        && request.resource.data.before_picture_url.size() > 0;

      // Workers may only move status forward and may not touch the
      // original report fields.
      allow update: if request.auth != null
        && resource.data.status != 'Completed'
        && request.resource.data.status in ['In Progress', 'Completed']
        && request.resource.data.area == resource.data.area
        && request.resource.data.before_picture_url == resource.data.before_picture_url
        && request.resource.data.reported_by == resource.data.reported_by
        && request.resource.data.room_name == resource.data.room_name
        && request.resource.data.title == resource.data.title
        && request.resource.data.type == resource.data.type
        && request.resource.data.priority == resource.data.priority;

      allow delete: if false;
    }

    // Projects are longer, planned pieces of work tied to a location (the same
    // Rooms / Public Area / Restaurant list as defects). They carry a timeline,
    // a person-in-charge (PIC), and a planning scope, and are updated over time
    // as work progresses.
    match /projects/{projectId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.area in ['Rooms', 'Public Area', 'Restaurant']
        && request.resource.data.room_name is string
        && request.resource.data.room_name.size() > 0
        && validRoomName(request.resource.data.area, request.resource.data.room_name)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.pic is string
        && request.resource.data.pic.size() > 0
        && request.resource.data.status in ['Planned', 'In Progress', 'On Hold', 'Completed']
        && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;

      // Updates may revise the plan, timeline, status and progress, but never
      // the project's identity (which location/title it is, or when it was
      // created).
      allow update: if request.auth != null
        && request.resource.data.area == resource.data.area
        && request.resource.data.room_name == resource.data.room_name
        && request.resource.data.title == resource.data.title
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.status in ['Planned', 'In Progress', 'On Hold', 'Completed']
        && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;

      allow delete: if false;
    }

    // Daily briefing minutes — one document per day, keyed YYYY-MM-DD.
    // Holds the morning/evening meeting notes plus manually-entered occupancy
    // and estimated arrival/departure numbers. Written with set+merge, so the
    // rules see the full merged document.
    match /briefings/{day} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('occupancy' in request.resource.data)
            || request.resource.data.occupancy == null
            || (request.resource.data.occupancy is number
                && request.resource.data.occupancy >= 0
                && request.resource.data.occupancy <= 100))
        && (!('est_arrival' in request.resource.data)
            || request.resource.data.est_arrival == null
            || (request.resource.data.est_arrival is number
                && request.resource.data.est_arrival >= 0))
        && (!('est_departure' in request.resource.data)
            || request.resource.data.est_departure == null
            || (request.resource.data.est_departure is number
                && request.resource.data.est_departure >= 0))
        && (!('morning_notes' in request.resource.data)
            || request.resource.data.morning_notes == null
            || request.resource.data.morning_notes is string)
        && (!('evening_notes' in request.resource.data)
            || request.resource.data.evening_notes == null
            || request.resource.data.evening_notes is string);

      allow delete: if false;
    }
  }
}
